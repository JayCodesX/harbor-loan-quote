# Copy to .env and fill in. .env is gitignored and must never be committed.
#
# Generate an RS256 keypair (single-line base64). The private key MUST be PKCS8
# (note: macOS/LibreSSL `genpkey -outform DER` emits PKCS1, so convert with pkcs8):
#   openssl genpkey -algorithm RSA -pkeyopt rsa_keygen_bits:2048 -out priv.pem
#   openssl pkcs8 -topk8 -nocrypt -in priv.pem -outform DER -out priv.p8.der
#   base64 -i priv.p8.der | tr -d '\n'    # -> APP_SERVICE_TOKEN_PRIVATE_KEY (PKCS8)
#   openssl pkey -in priv.pem -pubout -outform DER -out pub.der
#   base64 -i pub.der | tr -d '\n'        # -> APP_SERVICE_TOKEN_PUBLIC_KEY (X509)
# HMAC secrets:  openssl rand -hex 32

DB_PASSWORD=changeme
MYSQL_ROOT_PASSWORD=changeme
RABBITMQ_USERNAME=guest
RABBITMQ_PASSWORD=changeme

APP_USER_TOKEN_SECRET=replace-with-openssl-rand-hex-32
APP_SERVICE_TOKEN_SECRET=replace-with-openssl-rand-hex-32
APP_PRICING_RESULT_TOKEN_SECRET=replace-with-openssl-rand-hex-32
APP_NOTIFICATION_TOKEN_SECRET=replace-with-openssl-rand-hex-32
APP_OUTBOUND_SERVICE_TOKEN_SECRET=replace-with-openssl-rand-hex-32

APP_SERVICE_TOKEN_PRIVATE_KEY=replace-with-base64-pkcs8-private-key
APP_SERVICE_TOKEN_PUBLIC_KEY=replace-with-base64-x509-public-key

# Keycloak (optional OIDC profile)
KEYCLOAK_ADMIN_USERNAME=admin
KEYCLOAK_ADMIN_PASSWORD=changeme
KEYCLOAK_DEMO_USER_PASSWORD=changeme
