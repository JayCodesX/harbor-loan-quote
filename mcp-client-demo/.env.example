# MCP client demo configuration.
#
# Local:  copy this file to `.env` and fill in values (`.env` is gitignored).
# Deploy: set these as real environment variables (Oracle Cloud, systemd, a
#         container env, etc.). A real environment variable always overrides `.env`.

# pricing-service base URL.
#   Local:  http://localhost:8084
#   Deploy: the service's reachable URL, e.g. https://pricing.<your-domain>
#           (behind the Cloudflare Tunnel from the Stage-4 deploy).
MCP_BASE_URL=http://localhost:8084

# REQUIRED. The X-API-Key the MCP gateway accepts (ADR-0053). Must match one of
# pricing-service's HARBOR_MCP_API_KEYS. NEVER commit a real key — keep it in .env
# locally and in the deployment's secret store in production.
MCP_API_KEY=test-key-123

# Ollama server. Local daemon by default; change if Ollama runs elsewhere.
OLLAMA_URL=http://localhost:11434

# Model name. Any tool-capable model:
#   - an Ollama Cloud tag after `ollama signin`, e.g. gpt-oss:120b-cloud
#   - a local model, e.g. llama3.1:8b
OLLAMA_MODEL=gpt-oss:120b-cloud
