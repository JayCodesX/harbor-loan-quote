# MCP client demo configuration.
#
# Local:  copy this file to `.env` and fill in values (`.env` is gitignored).
# Deploy: set these as real environment variables (Oracle Cloud, systemd, a
#         container env, etc.). A real environment variable always overrides `.env`.

# --- MCP server (the pricing engine's agent boundary) ---

# pricing-service base URL.
#   Local:  http://localhost:8084
#   Deploy: the service's reachable URL, e.g. https://pricing.<your-domain>
#           (behind the Cloudflare Tunnel from the Stage-4 deploy).
MCP_BASE_URL=http://localhost:8084

# REQUIRED. The X-API-Key the MCP gateway accepts (ADR-0053). Must match one of
# pricing-service's HARBOR_MCP_API_KEYS. NEVER commit a real key.
MCP_API_KEY=test-key-123

# --- LLM provider (OpenAI Chat Completions standard: base_url + api_key + model) ---
# The client is provider-agnostic. Point these at ANY OpenAI-compatible provider.
#
#   Provider       LLM_BASE_URL                     LLM_MODEL
#   local Ollama   http://localhost:11434/v1        gpt-oss:120b-cloud
#   Ollama Cloud   https://ollama.com/v1            gpt-oss:120b-cloud
#   OpenAI         https://api.openai.com/v1        gpt-4o
#   Groq           https://api.groq.com/openai/v1   llama-3.3-70b-versatile

LLM_BASE_URL=http://localhost:11434/v1

# Bearer key for the provider. For local Ollama any value works ("ollama");
# for Ollama Cloud / OpenAI / others, use that provider's real key. Never commit it.
LLM_API_KEY=ollama

# Model name (must support tool/function calling). For an Ollama *-cloud model,
# run `ollama signin` once so the local daemon can reach it.
LLM_MODEL=gpt-oss:120b-cloud
