# Production environment for the Oracle Cloud + Cloudflare Tunnel deploy (ADR-0055).
# Copy to .env.prod and fill in. .env.prod is gitignored — never commit real values.
# Pass it with: docker compose --env-file .env.prod -f docker-compose.yml -f docker-compose.prod.yml ...
#
# Generate an RS256 keypair (single-line base64; private key MUST be PKCS8):
#   openssl genpkey -algorithm RSA -pkeyopt rsa_keygen_bits:2048 -out priv.pem
#   openssl pkcs8 -topk8 -nocrypt -in priv.pem -outform DER -out priv.p8.der
#   base64 -i priv.p8.der | tr -d '\n'    # -> APP_SERVICE_TOKEN_PRIVATE_KEY
#   openssl pkey -in priv.pem -pubout -outform DER -out pub.der
#   base64 -i pub.der | tr -d '\n'        # -> APP_SERVICE_TOKEN_PUBLIC_KEY
# HMAC secrets:   openssl rand -hex 32
# MCP API key:    openssl rand -hex 24

# --- datastore / broker credentials ---
DB_PASSWORD=CHANGE_ME
MYSQL_ROOT_PASSWORD=CHANGE_ME
RABBITMQ_USERNAME=harbor
RABBITMQ_PASSWORD=CHANGE_ME

# --- service-to-service auth (HMAC secrets + RSA keypair) ---
APP_USER_TOKEN_SECRET=CHANGE_ME
APP_SERVICE_TOKEN_SECRET=CHANGE_ME
APP_PRICING_RESULT_TOKEN_SECRET=CHANGE_ME
APP_NOTIFICATION_TOKEN_SECRET=CHANGE_ME
APP_OUTBOUND_SERVICE_TOKEN_SECRET=CHANGE_ME
APP_SERVICE_TOKEN_PRIVATE_KEY=CHANGE_ME_BASE64_PKCS8
APP_SERVICE_TOKEN_PUBLIC_KEY=CHANGE_ME_BASE64_X509

# --- agent-facing MCP boundary (ADR-0053) ---
# One or more accepted API keys (comma-separated). The MCP client demo sets its
# MCP_API_KEY to one of these. Rotate by adding a new key, then removing the old.
HARBOR_MCP_API_KEYS=CHANGE_ME
HARBOR_MCP_RPM=60

# --- misc ---
# The Java services keep AWS_* at dummy values (SQS is the Phase-3 path, unused here).
AWS_ACCESS_KEY_ID=unused
AWS_SECRET_ACCESS_KEY=unused
